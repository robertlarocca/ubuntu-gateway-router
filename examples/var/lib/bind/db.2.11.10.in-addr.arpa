$TTL 3600
$ORIGIN 2.11.10.in-addr.arpa.
;
; VLAN 2 (wifi) reverse zone - dynamic, see note in db.internal.
;
@       IN SOA  ns1.internal. hostmaster.internal. (
                2026083101 3600 600 1209600 3600 )

        IN NS   ns1.internal.

; The gateway's own PTR, written with an absolute owner name.
1.2.11.10.in-addr.arpa.  IN PTR  gw-wifi.internal.
